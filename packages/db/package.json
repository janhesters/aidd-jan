{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./operators": "./src/operators.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "check:format": "oxfmt --check .",
    "fix:format": "oxfmt --write .",
    "check:lint": "oxlint --type-aware",
    "check:types": "tsc",
