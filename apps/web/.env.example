# Set to "false" to add noindex/nofollow meta tag and X-Robots-Tag header.
# Omit or set to "true" to allow search engine indexing.
ALLOW_INDEXING=true

# Random string for encryption and hashing (has dev default, must override in production).
# Generate at https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=s3cr3t-f0r-d3v-0nly-ch4ng3-1n-pr0d

# Base URL for Better Auth callbacks and redirects.
BETTER_AUTH_URL=https://web.localhost

# Secret used to sign cookies (color-scheme, etc.).
COOKIE_SECRET=s3cr3t

# Google OAuth credentials (uses emulate defaults for local dev).
# For production, set these to real Google Cloud Console credentials.
GOOGLE_CLIENT_ID=emulate-google-client-id
GOOGLE_CLIENT_SECRET=emulate-google-client-secret

# Google Places API key for business search autocomplete.
# Not needed when running with MOCKS=true (local dev).
# Enable "Places API (New)" in Google Cloud Console for production.
# GOOGLE_PLACES_API_KEY=

# Sender address for transactional emails.
# EMAIL_FROM=noreply@example.com

# Resend API key for transactional emails (optional in development).
# https://resend.com/api-keys
# RESEND_API_KEY=

# Turso database (leave empty for local SQLite file in development).
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
