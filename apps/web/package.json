{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint --type-aware",
    "check:types": "react-router typegen && tsgo",
    "db:push": "cd ../../packages/db && TURSO_DATABASE_URL=file:../../apps/web/local.db bun run drizzle-kit push",
    "db:reset": "rm -f local.db && bun run db:push",
    "dev": "MOCKS=true portless web react-router dev",
    "start:mocks": "MOCKS=true react-router-serve ./build/server/index.js",
    "test": "bun test",
    "start": "react-router-serve ./build/server/index.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.5.6",
    "@conform-to/react": "^1.17.1",
    "@conform-to/zod": "^1.17.1",
    "@libsql/client": "^0.17.2",
    "@nichtsam/helmet": "^0.3.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "@react-email/components": "^1.0.11",
    "@react-router/node": "7.14.0",
    "@react-router/serve": "7.14.0",
    "@tabler/icons-react": "^3.41.1",
    "@workspace/db": "workspace:*",
    "@workspace/email": "workspace:*",
    "@workspace/security": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.5.6",
    "cobe": "^2.0.1",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fetch-backend": "^7.0.0",
    "input-otp": "^1.4.2",
    "isbot": "^5.1.37",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "openimg": "^1.1.1",
    "pretty-cache-header": "^1.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "react-router": "7.14.0",
    "remix-i18next": "^7.4.2",
    "remix-utils": "^9.3.1",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@happy-dom/global-registrator": "^20.8.9",
    "@react-router/dev": "7.14.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@workspace/typescript-config": "workspace:*",
    "msw": "^2.12.14",
    "react-router-auto-routes": "^0.8.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  }
