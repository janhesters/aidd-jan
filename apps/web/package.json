{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "check:format": "oxfmt --check .",
    "fix:format": "oxfmt --write .",
    "check:lint": "oxlint --type-aware",
    "check:types": "react-router typegen && tsc",
    "db:push": "cd ../../packages/db && TURSO_DATABASE_URL=file:../../apps/web/local.db bun run drizzle-kit push",
    "db:reset": "rm -f local.db && bun run db:push",
    "dev": "MOCKS=true portless web react-router dev",
    "start:mocks": "MOCKS=true react-router-serve ./build/server/index.js",
    "test": "bun test",
    "start": "react-router-serve ./build/server/index.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@conform-to/react": "^1.21.1",
    "@conform-to/zod": "^1.21.1",
    "@libsql/client": "^0.18.0",
    "@nichtsam/helmet": "^0.3.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "@react-email/components": "^1.0.12",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "@tabler/icons-react": "^3.46.0",
    "@workspace/db": "workspace:*",
    "@workspace/email": "workspace:*",
    "@workspace/security": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.7.4",
    "cobe": "^2.0.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fetch-backend": "^8.0.0",
    "input-otp": "^1.5.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.46.0",
    "motion": "^13.3.0",
    "openimg": "^1.1.1",
    "pretty-cache-header": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router": "8.3.1",
    "remix-i18next": "^8.0.0",
    "remix-utils": "^10.0.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@react-router/dev": "8.3.1",
    "@rolldown/plugin-transform-imports": "^0.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workspace/typescript-config": "workspace:*",
    "msw": "^2.15.0",
    "react-router-auto-routes": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
