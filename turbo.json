{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "check:format": {},
    "check:lint": {},
    "check:types": {},
    "test": {},
    "e2e": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "passThroughEnv": [
        "ALLOW_INDEXING",
        "BETTER_AUTH_*",
        "COOKIE_SECRET",
        "EMAIL_FROM",
        "NODE_ENV",
        "PLAYWRIGHT_*",
        "RESEND_API_KEY",
        "TURSO_*"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "ui": "tui"
}
