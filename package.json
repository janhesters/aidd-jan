{
  "name": "aidd-jan",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "check:format": "turbo run check:format",
    "check:lint": "turbo run check:lint",
    "check:types": "turbo run check:types",
    "prepare": "husky",
    "e2e": "turbo run e2e",
    "test": "turbo run test",
    "tree": "tree . -I 'node_modules|dist|build|.git|coverage|.next|.turbo|playwright-report|test-results|inter|uploaded|openimg'",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:reset": "turbo run db:reset",
    "db:studio": "turbo run db:studio",
    "validate": "turbo run check:types check:lint check:format"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "js-yaml": "^4.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@nkzw/eslint-plugin": "^2.0.0",
    "@nkzw/oxlint-config": "^1.0.1",
    "@types/archiver": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.1",
    "@typescript/native-preview": "^7.0.0-dev.20260403.1",
    "@workspace/typescript-config": "workspace:*",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-perfectionist": "^5.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.19.0",
    "portless": "^0.9.4",
    "turbo": "^2.9.3",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.9"
}
