{
  "name": "aidd-jan",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "check:format": "turbo run check:format",
    "check:lint": "turbo run check:lint",
    "check:types": "turbo run check:types",
    "e2e": "turbo run e2e",
    "prepare": "husky",
    "test": "turbo run test",
    "validate": "turbo run check:types check:lint check:format"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@nkzw/oxlint-config": "^1.0.1",
    "@types/archiver": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260219.1",
    "@workspace/typescript-config": "workspace:*",
    "bun-types": "^1.3.9",
    "husky": "^9.1.7",
    "oxfmt": "^0.34.0",
    "oxlint": "^1.49.0",
    "oxlint-tsgolint": "^0.14.1",
    "turbo": "^2.8.9",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.9"
